{
  "$comment": "JackieG Reel Editor safety rules for Claude Code (merged into ~/.claude/settings.json only with the person's OK). deny = never; ask = Claude must ask first. Keeps beginners safe in auto mode: no sudo, no download-and-run scripts, no unpinned npx, no reading keys or SSH files, never delete video files.",
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | zsh*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(* | sh)",
      "Bash(* | bash)",
      "Bash(npx -y *)",
      "Bash(npx --yes *)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf /*)",
      "Bash(rm *.mov)",
      "Bash(rm *.MOV)",
      "Bash(rm *.mp4)",
      "Bash(rm *.MP4)",
      "Bash(rm *.m4v)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/reels/.env)",
      "Edit(~/.config/reels/.env)",
      "Read(**/.env)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(brew uninstall *)",
      "Bash(git push *)",
      "Bash(claude mcp add *)"
    ]
  }
}
